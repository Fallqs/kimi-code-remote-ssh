{
  "name": "@moonshot-ai/remote-ssh",
  "version": "0.1.0",
  "private": true,
  "description": "Remote Tool Server (RTS) protocol, stdio server, and transport-agnostic client for SSH-pipe remote tool execution",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/MoonshotAI/kimi-code/tree/main/packages/remote-ssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/remote-ssh"
  },
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "keywords": [
    "kimi",
    "ssh",
    "remote",
    "rpc",
    "filesystem",
    "process"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/generated/rts-bundle": [
      "./src/generated/rts-bundle.ts",
      "./src/generated/rts-bundle.d.ts"
    ],
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.rts.config.ts && node scripts/gen-rts-bundle.mjs && tsdown",
    "build:sea": "pnpm run build && node scripts/build-sea.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  }
}
